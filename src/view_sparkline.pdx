// src/view_sparkline.pdx -- postui-top.M3-001 (paideia-os/postui-top#4)
//
// ViewSparkline module: rolling-window CPU history sparkline.
//
// =============================================================================
// SCOPE (postui/docs/design.md §3.1 postui-top reference app, M3-001 slot)
// =============================================================================
//
// M1-001 landed the poll loop (src/poll.pdx: PollState + task_rows[]).
// M2-001 landed the Table view (src/view_table.pdx: table_draw wire).
// M3-001 (THIS landing) introduces the sparkline history view: a fixed-
// depth rolling window of aggregate CPU samples (one push per poll_tick)
// visualized via postui.M3-003's `sparkline_draw` widget. The M3-002
// Tabs landing will subdivide the canvas rect between the Table and this
// Sparkline; at this M3-001 slot the view is a stand-alone renderer
// whose caller decides the rect (via the caller-provided SparklineSpec
// scratch it hands to view_sparkline_render).
//
// This module ships:
//
//   * Two .bss statics -- a 64-slot u64 ring buffer (_vs_history) and
//     a single-slot ring cursor (_vs_head). Both are @align(8) so a
//     downstream u64 load is naturally aligned.
//   * `view_sparkline_push(cpu_sample) -> u64` -- append one sample to
//     the ring, advance the cursor mod 64. Nullary-return-value in
//     spirit (task text says "-> void"); the pdx surface has no void
//     type, so the wrapper returns 0 in rax as a no-error convention
//     (mirrors poll_init's return-0 posture at M1-001).
//   * `view_sparkline_render(spec_ptr, buf_ptr, rows, cols) -> u64` --
//     linearize `_vs_history` into `_vs_scratch` in chronological
//     order (scratch[0] = oldest slot, scratch[63] = newest), stamp
//     values_ptr = &_vs_scratch[64 - min(64, cols)] and
//     value_count = min(64, cols) into the caller-provided
//     SparklineSpec, then dispatch `sparkline_draw`. Rect / style /
//     max_override are caller-owned and passed through untouched.
//     The tail-slice + chronological ordering guarantees the rightmost
//     drawn column is ALWAYS the freshest sample, regardless of Rect.w
//     (fixes postui-top#8; see §RING-BUFFER LAYOUT below for the fix
//     rationale relative to the raw ring-through-strip mapping).
//
// =============================================================================
// SIGNATURE / DATA-SOURCE INTERPRETATION
// =============================================================================
//
// The M3-001 issue text prescribes:
//
//   view_sparkline_render(spec_ptr, buf, rows, cols) -> u64:
//     - Build SparklineSpec pointing at _vs_history[0], value_count=64.
//     - Call postui.sparkline_draw.
//
// The `spec_ptr` argument shape matches view_table_render's
// `poll_state_ptr` slot -- the FIRST arg names the data-adjacent input.
// For view_table_render that arg is the data source itself (poll_state);
// for view_sparkline_render the DATA source is this module's internal
// _vs_history ring, so spec_ptr instead carries the CALLER-owned
// SparklineSpec scratch (rect + style + max_override -- the geometry
// and normalization the caller wants for this frame). This module
// stamps ONLY the two fields the ring buffer is authoritative for
// (values_ptr + value_count), leaving the caller's rect / style /
// max_override intact so:
//
//   * A future M3-002 Tabs landing can pass a sub-rect (not the full
//     canvas) without churning view_sparkline_render's surface.
//   * A caller wanting a pinned Y-axis at max_override = 100 (%) for a
//     CPU% series can set it once at startup rather than re-computing
//     per frame.
//
// =============================================================================
// RING-BUFFER LAYOUT + LINEARIZE-ON-RENDER STRATEGY (postui-top#8 fix)
// =============================================================================
//
//   _vs_history[i] = u64 sample slot; storage stride = 8 bytes.
//   _vs_head       = u64 write cursor in [0, VS_RING_SLOTS = 64).
//   _vs_scratch[i] = u64 linearize destination (fed to sparkline_draw).
//
// Push semantics (unchanged; view_sparkline_push):
//   store _vs_history[_vs_head] = sample
//   _vs_head = (_vs_head + 1) & (VS_RING_SLOTS - 1)     [mod 64, imm8]
//
// The postui.M3-003 SparklineSpec authors document the widget's read
// contract:
//
//   values[] -- draw reads up to min(value_count, Rect.w) points; the
//   rightmost data points of a longer series are dropped, not the
//   leftmost. Callers wanting a ring-buffer newest-N view must reslice
//   their pointer before the call.
//                          -- postui/src/widgets/sparkline.pdx L64-L69
//
// The v1 landing passed &_vs_history[0] + value_count=64 verbatim.
// For any Rect.w < 64 only slots [0, Rect.w) in insertion-position
// order got drawn, which meant every sample pushed at head positions
// >= Rect.w was invisible; the strip appeared stale for most of each
// 64-tick cycle. This is postui-top#8.
//
// The fix (Option 1 from the v1 header's follow-up shortlist -- Option
// 2 "two adjacent sub-rect draws" was rejected because sparkline_draw
// treats its Rect as an authoritative left-edge and does not compose
// horizontally across two calls without visible seams / column
// misalignment): every `view_sparkline_render` frame linearizes the
// ring into `_vs_scratch` BEFORE dispatch:
//
//   for i in [0..64):
//     _vs_scratch[i] = _vs_history[(_vs_head + i) & 63]
//
// so `_vs_scratch[0]` is the OLDEST sample (slot _vs_head, about to
// be overwritten) and `_vs_scratch[63]` is the NEWEST (slot
// _vs_head - 1, the last thing pushed). The render body then hands
// sparkline_draw the RIGHT-anchored tail:
//
//   value_count = min(VS_RING_SLOTS, cols)
//   values_ptr  = &_vs_scratch[VS_RING_SLOTS - value_count]
//
// which sparkline_draw reads as min(value_count, Rect.w) = value_count
// (Rect.w == cols by construction), rendering the newest `cols`
// samples in chronological order across the whole width. The wrap-
// seam artefact of the raw-ring-through-strip mapping is eliminated
// -- the newest sample is ALWAYS at the rightmost column, and older
// samples shift left as the ring advances.
//
// Cost: one additional 64-slot BSS array (`_vs_scratch`, 512 B) and
// one 64-iteration qword copy loop per frame (~7 instructions of
// address arithmetic + a qword load/store, unrolled trivially by the
// hardware's out-of-order pipe). No external surface churn -- callers
// see the same signature.
//
// =============================================================================
// PRE-FILL TRANSIENT (first VS_RING_SLOTS pushes)
// =============================================================================
//
// _vs_history is BSS (zero-initialized at load); until 64 pushes have
// completed the ring holds a mix of live samples and residual zeros.
// The postui sparkline_draw path treats a zero value as "skip this
// column" (space-filled from phase 1, no bar stamp -- see
// postui/src/widgets/sparkline.pdx L639-L641). Startup therefore
// shows a partial strip that grows to full occupancy after ~64 poll
// ticks; no separate "count of populated slots" bookkeeping is
// needed. A caller wanting max_override auto-scaling before the
// ring fills can set max_override != 0 (the auto-max path
// short-circuits with the caller-pinned ceiling).
//
// =============================================================================
// STATIC SCRATCH FOOTPRINT (BSS, zero-initialized at load)
// =============================================================================
//
//   _vs_history  [u64; 64]  = 512 bytes    rolling sample ring
//   _vs_head     [u64; 1]   =   8 bytes    write cursor mod VS_RING_SLOTS
//   _vs_scratch  [u64; 64]  = 512 bytes    linearized snapshot (fix #8)
//
// Total = 1032 bytes (< 1 page). Sized to match the task-spec directly;
// growing VS_RING_SLOTS to a larger power-of-two (128, 256) is a
// one-constant edit here -- the `and r10, VS_RING_MASK` in both the
// push body AND the render body's linearize loop auto-follows so long
// as VS_RING_SLOTS stays a power of two (mask arithmetic; a non-power-
// of-two would need a `div` fallback). The `_vs_scratch` array must
// be grown in lockstep with `_vs_history`.
//
// =============================================================================
// SC+ / KERNEL EFFECT SURFACE
// =============================================================================
//
// Neither function issues a syscall. `view_sparkline_push` writes one
// qword to _vs_history and updates _vs_head; `view_sparkline_render`
// reads _vs_head, walks _vs_history writing 64 qwords into _vs_scratch
// (linearize loop), stamps two qwords into the caller-provided
// SparklineSpec, then calls `sparkline_draw`, which itself is a
// memory-only widget draw. Effect row `!{mem}` @{} matches
// sparkline_draw's own effect. No capability gate.
//
// =============================================================================
// PAIDEIA-AS CONFORMANCE
// =============================================================================
//
//   - Module name PascalCase basename (`ViewSparkline`), matches file
//     basename view_sparkline.pdx (module-basename-pascal invariant;
//     manifest.pdxproj compliance flag).
//   - No `test` mnemonic; every zero-check goes through `cmp reg, 0`.
//   - Every immediate in cmp/and fits imm32 (widest is
//     VS_RING_MASK = 63; all others are small).
//   - No 2-op `imul reg, imm` anywhere; no imul used at all
//     (index scaling folds to `shl rax, 3` for the *8 stride).
//   - No `mul` mnemonic; no `and reg, imm64`; no `cmp reg, [mem]`
//     (every compare loads through a scratch first -- there are
//     none in this module because both bodies are branch-free
//     modulo the alignment sub/add pair in the render wrapper).
//   - Every `pub let` declaration is single-line (multiline `pub let
//     ="..."` is a paideia-as pitfall).
//   - Reserved paideia-as keywords (`loop`, `if`, `then`, `else`,
//     `test`) NEVER appear as label names; every label prefixed
//     `vs_*` per the postui-top fingerprint discipline. Substring
//     "loop" avoided defensively -- the linearize loop's top label
//     is `vs_lin_top` (not `vs_lin_loop`) per the view_table.pdx
//     L349-L354 discipline note. view_sparkline_push remains
//     straight-line; view_sparkline_render carries two labels
//     (`vs_lin_top` for the 64-iter copy loop back-edge and
//     `vs_have_min` for the min-clamp continue).
//   - r11 usage: view_sparkline_push uses r11 as the base-address
//     register for two `lea r11, [rip + label]` sites; the linearize
//     loop in view_sparkline_render uses r11 similarly for the
//     `_vs_history` load and the `_vs_scratch` store in each of the
//     64 iterations (four `lea r11, [rip + label]` sites total in
//     view_sparkline_render across all phases). paideia-as's
//     `lea reg, [rip + label]` uses r11 as internal scratch (see
//     postui/src/widgets/sparkline.pdx L442-L446 discipline note),
//     so the destination register IS r11 and no other state relies
//     on r11 surviving those lea instructions.
//   - SysV push/pop parity:
//       * view_sparkline_push: pure leaf (no push/pop, no callee-save
//         touched, no nested call).
//       * view_sparkline_render: entry rsp%16==8; `sub rsp, 8` before
//         the call to sparkline_draw makes rsp%16==0 at the callsite
//         (SysV nested-call invariant). `add rsp, 8` restores before
//         `ret`. No callee-save regs touched -- the linearize loop
//         confines itself to caller-save regs (rax/r8/r9/r10/r11);
//         the four SysV arg regs (rdi/rsi/rdx/rcx) are never
//         overwritten between entry and the sparkline_draw call
//         (Phase B reads rcx into r8 but rcx itself stays intact,
//         and rdi is only dereferenced for the two stamp stores).

module ViewSparkline = structure {

  // ==========================================================================
  // Sizing constants
  //
  // VS_RING_SLOTS is a compile-time power-of-two -- the push body's mod
  // fold uses `and rax, VS_RING_MASK` (imm8) rather than an `xor/div`
  // pair. A future revision that wants a different depth (128, 256)
  // updates both constants together (mask = slots - 1) and re-grows
  // the _vs_history array; nothing else changes.
  // ==========================================================================
  pub let VS_RING_SLOTS : u64 = 64
  pub let VS_RING_MASK  : u64 = 63    // VS_RING_SLOTS - 1
  pub let VS_SLOT_BYTES : u64 = 8     // sizeof(u64)

  // ==========================================================================
  // SparklineSpec field offsets (mirror of postui/src/widgets/sparkline.pdx
  // SPARKLINE_OFF_* -- named locally so the render body's stamp sites
  // read from a self-documenting symbol and a downstream SparklineSpec
  // layout revision is caught at exactly one place).
  // ==========================================================================
  pub let VS_SPEC_OFF_VALUES_PTR  : u64 = 8
  pub let VS_SPEC_OFF_VALUE_COUNT : u64 = 16

  // ==========================================================================
  // Static storage. All three live in .bss (zero-initialized at load).
  // The push body overwrites _vs_history slots in ring-cursor order and
  // advances _vs_head; the render body reads _vs_head + _vs_history in
  // the linearize loop, writes _vs_scratch in the same loop, and then
  // reads _vs_scratch through sparkline_draw.
  // ==========================================================================
  pub let mut _vs_history : [u64; 64] = uninit @align(8)
  pub let mut _vs_head    : [u64; 1]  = uninit @align(8)

  // ==========================================================================
  // Linearization scratch (postui-top#8 fix).
  //
  // view_sparkline_render copies _vs_history into this buffer in chronological
  // order at every frame BEFORE calling sparkline_draw, so that _vs_scratch[0]
  // is the OLDEST sample and _vs_scratch[63] is the NEWEST. The render body
  // then hands sparkline_draw a pointer into the tail of this buffer so the
  // rightmost drawn column is always the freshest sample -- fixing the "stale
  // pane for < 64-col Rects" defect (postui-top#8) where the raw ring-through-
  // strip mapping only rendered slots [0, Rect.w) in insertion-position order,
  // leaving samples at head positions >= Rect.w invisible.
  //
  // 512 bytes; @align(8) so the qword copy-loop's stores land naturally
  // aligned. Zero-initialized at load (BSS).
  // ==========================================================================
  pub let mut _vs_scratch : [u64; 64] = uninit @align(8)

  // ==========================================================================
  // view_sparkline_push(cpu_sample) -> u64
  //
  // Append one CPU sample to the rolling ring, advance the cursor mod
  // VS_RING_SLOTS. Returns 0 (task-spec "-> void"; pdx has no void type
  // so the wrapper returns 0 in rax as a no-error convention, matching
  // poll_init's posture at M1-001).
  //
  // Contract:
  //   rdi = cpu_sample     u64 aggregate CPU tick (or CPU%) sample
  //   -> rax = 0           always
  //
  // Algorithm:
  //   head = _vs_head[0]
  //   _vs_history[head] = rdi
  //   _vs_head[0] = (head + 1) & VS_RING_MASK
  //   return 0
  //
  // Register plan (pure leaf, no push/pop, no nested call):
  //   rax = head (loaded, then reused as byte offset via shl 3)
  //   r10 = head-copy preserved across the shl for the +1&mask step
  //   r11 = lea scratch for [rip + _vs_history] / [rip + _vs_head]
  //         (paideia-as internal-scratch convention -- see
  //          postui/src/widgets/sparkline.pdx L442-L446)
  //
  // Labels: none (linear body, no branches). The `vs_*` prefix is
  // reserved for any future branch label; substring "loop" is
  // defensively avoided even inside a compound identifier.
  // ==========================================================================
  pub let view_sparkline_push : (u64) -> u64 !{mem} @{} =
    fn (cpu_sample: u64) -> unsafe {
      effects: {mem}, capabilities: {},
      justification: "postui-top.M3-001 (postui-top#4): view_sparkline_push appends one u64 CPU sample to the _vs_history rolling ring and advances _vs_head mod VS_RING_SLOTS=64. Pure leaf: no push/pop, no callee-save touched, no nested call. Phase 1 (load head): mov rax, [rip + _vs_head + 0] -- direct RIP-relative load, no r11 scratch involvement (paideia-as pitfall #1248 note: only `lea reg, [rip + label]` uses r11 as internal scratch; plain `mov reg, [rip + label + offset]` does not, per postui/src/poll.pdx L480 precedent). Phase 2 (compute slot address + store sample): mov r10, rax (save head for the +1&mask step); shl rax, 3 (rax = head * VS_SLOT_BYTES=8, imm8); lea r11, [rip + _vs_history] (r11 is both destination and paideia-as internal scratch -- no conflict); add r11, rax (r11 = &_vs_history[head]); mov [r11 + 0], rdi (store sample). Phase 3 (advance cursor mod 64): add r10, 1 (imm8); and r10, 63 (VS_RING_MASK, imm8 -- power-of-two mod fold, no div); lea r11, [rip + _vs_head] (fresh lea, r11 re-clobber safe); mov [r11 + 0], r10 (store new head). Phase 4 (return 0): xor rax, rax; ret. Encoder discipline: no `test` (no branches); no imul (index stride is shl 3); no `and reg, imm64` (mask is 63, imm8); no `cmp reg, imm64`; no `cmp reg, [mem]`; no `mul` mnemonic. Every immediate (0, 1, 3, 63) fits imm8. Byte-load discipline not applicable (all loads/stores are qword). No callee-save regs touched -- rdi (arg), rax/r10/r11 (SysV caller-save) sole registers used. Effect !{mem} (writes _vs_history and _vs_head; reads _vs_head). Labels prefixed vs_ per postui-top fingerprint discipline; substring \"loop\" avoided defensively.",
      block: {
        // Phase 1: load head into rax
        mov rax, [rip + _vs_head + 0];

        // Phase 2: compute _vs_history[head] address + store sample
        mov r10, rax;                              // save head-copy for phase 3
        shl rax, 3;                                // rax = head * VS_SLOT_BYTES(8)
        lea r11, [rip + _vs_history];
        add r11, rax;                              // r11 = &_vs_history[head]
        mov [r11 + 0], rdi;                        // store cpu_sample

        // Phase 3: advance cursor mod VS_RING_SLOTS
        add r10, 1;                                // head + 1
        and r10, 63;                               // & VS_RING_MASK (mod 64)
        lea r11, [rip + _vs_head];
        mov [r11 + 0], r10;                        // store new head

        // Phase 4: return 0 (no-error convention for a void-shaped op)
        xor rax, rax;
        ret;
      }
    }

  // ==========================================================================
  // view_sparkline_render(spec_ptr, buf_ptr, rows, cols) -> u64
  //
  // Linearize the _vs_history ring into _vs_scratch (chronological
  // order: scratch[0] = oldest, scratch[63] = newest), stamp
  // values_ptr = &_vs_scratch[64 - min(64, cols)] and
  // value_count = min(64, cols) into the caller-provided SparklineSpec
  // at spec_ptr, then dispatch sparkline_draw. Rect / style /
  // max_override at spec_ptr are caller-owned and pass through
  // untouched (see §SIGNATURE / DATA-SOURCE INTERPRETATION for the
  // layered-caller rationale, and §RING-BUFFER LAYOUT for the
  // linearize-on-render fix rationale relative to postui-top#8).
  //
  // Contract:
  //   rdi = spec_ptr       VA of a 40-byte SparklineSpec (see
  //                        postui/src/widgets/sparkline.pdx L268)
  //                        with rect/max_override/style pre-populated
  //                        by the caller
  //   rsi = buf_ptr        VA of a rows*cols grid of 16-byte Cells
  //   rdx = rows           canvas row count (unread by sparkline_draw
  //                        per its documented posture, but preserved
  //                        through this wrapper for signature parity)
  //   rcx = cols           canvas col count (used by sparkline_draw
  //                        for the dst = buf + (y*cols+x)*16 fold,
  //                        AND used here to cap value_count so the
  //                        tail-slice matches the drawn width)
  //   -> rax               0 on success, or the postui SPK_ERR_BAND
  //                        (0xFFFFEBD3) verbatim from sparkline_draw
  //                        (v1 sparkline_draw never returns this
  //                        sentinel; reserved for a future revision).
  //
  // Algorithm:
  //   Phase A: for i in [0..64):
  //              _vs_scratch[i] = _vs_history[(_vs_head + i) & 63]
  //   Phase B: value_count = min(64, cols)
  //            values_ptr  = &_vs_scratch[64 - value_count]
  //            [spec_ptr + VS_SPEC_OFF_VALUES_PTR]  = values_ptr
  //            [spec_ptr + VS_SPEC_OFF_VALUE_COUNT] = value_count
  //   Phase C: return sparkline_draw(spec_ptr, buf_ptr, rows, cols)
  //
  // Register plan (no callee-save touched; all work in caller-save):
  //   rdi / rsi / rdx / rcx = SysV args (all preserved through Phases
  //                                       A and B; rcx is read into r8
  //                                       for min-clamp but rcx itself
  //                                       stays intact; rdi is only
  //                                       dereferenced for the two stamp
  //                                       stores)
  //   rax = transient value / linearize load-through / values_ptr stamp
  //   r8  = linearize iterator (Phase A) then value_count (Phase B)
  //   r9  = head snapshot (Phase A) then scratch tail byte-offset (Phase B)
  //   r10 = per-iteration address scratch (Phase A only)
  //   r11 = lea internal scratch AND base-address register for the four
  //         `lea r11, [rip + label]` sites (two per linearize iteration
  //         for _vs_history load + _vs_scratch store). Destination IS r11
  //         at every lea site, so paideia-as's internal-scratch clobber
  //         is a no-op.
  //
  // Stack: `sub rsp, 8` before the call (SysV entry rsp%16==8; +8 ->
  // rsp%16==0 at the sparkline_draw callsite, satisfying its own
  // 5-push+80-scratch alignment expectations). The linearize loop
  // itself makes no nested calls and needs no stack scratch. No
  // callee-save regs touched.
  //
  // Labels: `vs_lin_top` (linearize loop back-edge), `vs_have_min`
  // (min-clamp fall-through). Substring "loop" avoided defensively
  // per view_table.pdx L349-L354 discipline. Fingerprint prefix `vs_`.
  // ==========================================================================
  pub let view_sparkline_render : (u64, u64, u64, u64) -> u64 !{mem} @{} =
    fn (spec_ptr: u64) (buf_ptr: u64) (rows: u64) (cols: u64) -> unsafe {
      effects: {mem}, capabilities: {},
      justification: "postui-top.M3-001 render + postui-top#8 fix: view_sparkline_render (a) linearizes the _vs_history ring into _vs_scratch so scratch[0]=oldest and scratch[63]=newest, then (b) stamps values_ptr = &_vs_scratch[64 - min(64, cols)] and value_count = min(64, cols) into the caller-provided SparklineSpec at spec_ptr, then (c) dispatches sparkline_draw with rdi/rsi/rdx/rcx passed through unmodified. This addresses postui-top#8: sparkline_draw draws min(value_count, Rect.w) points starting at values[0]; the old body passed &_vs_history[0]+64 which for Rect.w<64 rendered only slots [0, Rect.w) in insertion-position order, so samples pushed at head positions >= Rect.w never appeared. The linearize-then-tail-slice pattern makes the rightmost drawn column always the freshest sample, regardless of Rect.w. Phase A (linearize, formula scratch[i] = _vs_history[(head + i) & 63] for i in [0..64)): mov r9, [rip + _vs_head + 0] (direct RIP-relative load; per pitfall #1248 only lea uses r11 as internal scratch, plain mov does not); xor r8, r8 (i=0); vs_lin_top: compute src offset: mov r10, r9; add r10, r8; and r10, 63 (VS_RING_MASK, imm8; power-of-two mod fold); shl r10, 3 (VS_SLOT_BYTES=8, imm8; NOT imul); lea r11, [rip + _vs_history] (r11 dest = paideia-as internal scratch, no conflict); add r11, r10; mov rax, [r11 + 0] (load qword sample). Compute dst offset: mov r10, r8; shl r10, 3; lea r11, [rip + _vs_scratch]; add r11, r10; mov [r11 + 0], rax (store qword). Increment: add r8, 1 (imm8); cmp r8, 64 (imm8); jne vs_lin_top. Loop count = 64 iterations, always runs at least once (i=0 initially, body always executes before the compare). No callee-save touched; every register used (rax, r8, r9, r10, r11) is caller-save AND not an arg reg (rdi/rsi/rdx/rcx pass through Phase A unmodified). Phase B (compute effective values_ptr + value_count): mov r8, rcx (r8 = cols); cmp r8, 64 (imm8); jbe vs_have_min; mov r8, 64 (imm8); vs_have_min: r8 = min(cols, 64). Compute scratch tail-offset: mov r9, 64 (imm8); sub r9, r8; shl r9, 3 (byte offset, imm8). Stamp values_ptr: lea rax, [rip + _vs_scratch]; add rax, r9; mov [rdi + 8], rax (VS_SPEC_OFF_VALUES_PTR=8, imm8). Stamp value_count: mov [rdi + 16], r8 (VS_SPEC_OFF_VALUE_COUNT=16, imm8). Note rdi/rsi/rdx/rcx untouched across Phase B: r8 was loaded FROM rcx but rcx itself is intact; rdi is dereferenced but never overwritten. Phase C (dispatch): sub rsp, 8 -- SysV entry rsp%16==8, +8 -> rsp%16==0 for the nested sparkline_draw call (which itself does 5 pushes + sub rsp, 80 = 120B keeping its own frame 16B-aligned per postui/src/widgets/sparkline.pdx L400 discipline); call sparkline_draw; add rsp, 8; ret. rax carries sparkline_draw's return verbatim (0 on OK; SPK_ERR_BAND 0xFFFFEBD3 reserved for future). Encoder discipline: no `test` (zero-check via cmp r8, 0 pattern; loop uses cmp r8, 64 backwards-branch); no imul (all strides via shl imm8); no `and reg, imm64` (widest is 63, imm8); no `cmp reg, imm64` (widest is 64, imm8); no `cmp reg, [mem]`; no `mul` mnemonic; every immediate (0, 1, 3, 8, 16, 63, 64) fits imm8. r11 clobbered by every `lea r11, [rip + label]` -- we never rely on r11 surviving across a lea (destination IS r11 at all four lea sites in this body). No callee-save touched (loop body carries no state across the nested sparkline_draw call; the only value that must survive is rax, which IS sparkline_draw's own return). Effect !{mem} matches sparkline_draw's own effect (scratch writes + spec-slot stamps + values-array read + cell writes). Labels: vs_lin_top (loop top), vs_have_min (min-clamp continue). Substring `loop` avoided defensively in every label per the view_table.pdx L349-L354 discipline (uses `vs_lin_top` not `vs_lin_loop`). Cross-module symbol: sparkline_draw resolves at link-time against postui/src/widgets/sparkline.pdx per the deps: postui @ ^0.1 entry in manifest.pdxproj.",
      block: {
        // ================================================================
        // Phase A: linearize _vs_history into _vs_scratch so that
        //          scratch[0] = oldest sample (slot _vs_head)
        //          scratch[63] = newest sample (slot _vs_head - 1)
        //
        //          Formula: scratch[i] = _vs_history[(head + i) & 63]
        //          for i in [0..64).
        //
        //          The `head + i` walk starts at the oldest slot (about
        //          to be overwritten next tick) and ends at head - 1
        //          (the just-pushed sample), producing a chronologically-
        //          ordered snapshot with the newest sample on the right.
        // ================================================================
        mov r9, [rip + _vs_head + 0];              // r9 = head (mod VS_RING_SLOTS)
        xor r8, r8;                                // r8 = i = 0

      vs_lin_top:
        // src offset = ((head + i) & VS_RING_MASK) * VS_SLOT_BYTES
        mov r10, r9;                               // r10 = head
        add r10, r8;                               // r10 = head + i
        and r10, 63;                               // r10 = (head + i) & VS_RING_MASK
        shl r10, 3;                                // r10 = src * VS_SLOT_BYTES(8)
        lea r11, [rip + _vs_history];
        add r11, r10;                              // r11 = &_vs_history[src]
        mov rax, [r11 + 0];                        // rax = _vs_history[src]

        // dst offset = i * VS_SLOT_BYTES
        mov r10, r8;                               // r10 = i
        shl r10, 3;                                // r10 = i * VS_SLOT_BYTES(8)
        lea r11, [rip + _vs_scratch];
        add r11, r10;                              // r11 = &_vs_scratch[i]
        mov [r11 + 0], rax;                        // _vs_scratch[i] = rax

        add r8, 1;                                 // ++i
        cmp r8, 64;                                // i vs VS_RING_SLOTS
        jne vs_lin_top;

        // ================================================================
        // Phase B: compute the effective slice for sparkline_draw --
        //          right-anchored tail of _vs_scratch of length
        //          min(VS_RING_SLOTS, cols), so the rightmost drawn
        //          column is always the freshest sample.
        //
        //   value_count = min(64, cols)
        //   values_ptr  = &_vs_scratch[64 - value_count]
        //
        // sparkline_draw will then read min(value_count, Rect.w) = the
        // full value_count (because Rect.w = cols and value_count is
        // capped at cols), rendering the newest cols samples.
        // ================================================================
        mov r8, rcx;                               // r8 = cols
        cmp r8, 64;                                // cols vs VS_RING_SLOTS
        jbe vs_have_min;
        mov r8, 64;                                // r8 = min(cols, 64)
      vs_have_min:

        // scratch tail-offset in bytes = (VS_RING_SLOTS - value_count) * VS_SLOT_BYTES
        mov r9, 64;                                // VS_RING_SLOTS
        sub r9, r8;                                // 64 - value_count
        shl r9, 3;                                 // * VS_SLOT_BYTES(8)

        // stamp values_ptr = &_vs_scratch[64 - value_count]
        lea rax, [rip + _vs_scratch];
        add rax, r9;
        mov [rdi + 8], rax;                        // VS_SPEC_OFF_VALUES_PTR

        // stamp value_count
        mov [rdi + 16], r8;                        // VS_SPEC_OFF_VALUE_COUNT

        // ================================================================
        // Phase C: dispatch sparkline_draw
        //          (rdi/rsi/rdx/rcx pass through unmodified from entry)
        // ================================================================
        sub rsp, 8;                                // SysV align: rsp%16==8 -> 0
        call sparkline_draw;
        add rsp, 8;
        ret;
      }
    }

}
